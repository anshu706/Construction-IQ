# ==============================================================================
# ConstructIQ Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=3001

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://constructiq:constructiq_secret@localhost:5432/constructiq?schema=public

# Session Secret (Minimum 32 characters for HMAC SHA-256 session signature)
SESSION_SECRET=constructiq_secure_session_secret_32_chars_min!

# Demo Mode ('true' enables scenario simulations and demo data writing; 'false' in production)
DEMO_MODE=true

# Demo User Password (used by seed script)
DEMO_PASSWORD=DemoPass123!

# AI Copilot Credentials (Optional - server falls back to Gemini or provides 503 if omitted)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
GEMINI_API_KEY=

# Local File Uploads Directory
UPLOAD_DIR=./uploads

# AWS S3 Storage (Optional in production for photo assets)
S3_BUCKET=
AWS_REGION=us-east-1
